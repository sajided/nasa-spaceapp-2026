{
  "name": "apollo-11-interactive-journey",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scroll-driven 3D replay of the Apollo 11 mission, with the children's story \"The Monuments We Left Behind\".",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "size": "node scripts/size-check.mjs",
    "prepare:engines": "node scripts/prepare-engines.mjs",
    "prepare:textures": "node scripts/prepare-textures.mjs",
    "prepare:audio": "node scripts/prepare-audio.mjs"
  },
  "dependencies": {
    "animejs": "^4.5.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.2",
    "@types/three": "^0.186.0",
    "sharp": "^0.35.4",
    "typescript": "^5.6.0",
    "vite": "^8.3.0"
  }
}
